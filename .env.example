# =============================================================================
# Vistora Environment Variables
# =============================================================================

# 1. Supabase Public Client Configuration (Exposed to browser via Vite)
# Found in Supabase Dashboard -> Project Settings -> API Keys / Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# 2. Supabase Backend Secret (Serverless /api/forum only - NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
# Optional server-side URL alias if different or if you prefer not to share VITE_SUPABASE_URL:
# SUPABASE_URL=https://your-project-ref.supabase.co

# 3. Primary AI Provider Secret (Serverless /api/puku only - NEVER prefix with VITE_)
PUKU_API_KEY=pk_live_your_puku_api_key_here
# Optional Puku AI overrides (defaults shown):
# PUKU_BASE_URL=https://api-cli.puku.sh
# PUKU_MODEL=puku-ai-2.8

# 4. Fallback AI Provider Secrets (Serverless /api/puku only - NEVER prefix with VITE_)
# Used automatically if Puku AI fails or is unavailable:
GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# 5. Optional External Evaluation / API Endpoints
# VITE_EVALUATION_API_URL=
# VITE_DOCUMENT_API_URL=
# VITE_EXAM_DATES_API_URL=
